# Godot
.godot/
**/.godot/
*.translation
export_credentials.cfg
admob.properties
android/build/admob.properties

# Build outputs (APK/AAB, zips, signed artifacts, keystore, notes)
/build/
*.apk
*.aab
*.idsig
*.keystore
*.jks

# Android / Gradle: generated output only, the template sources stay tracked
android/build/.gradle/
android/build/**/build/
android/build/local.properties
android/build/*.iml

# Godot Android export copies the packed game here on every export (and
# wipes previous contents, including keep.txt). Ignore the dump; keep.txt
# placeholders stay tracked via the exceptions below.
android/build/src/main/assets/**
!android/build/src/main/assets/keep.txt
android/build/assetPackInstallTime/src/main/assets/**
!android/build/assetPackInstallTime/src/main/assets/keep.txt

# Godot Android template binaries (~210 MB; reinstall with the official
# Android build template: Project > Install Android Build Template)
android/build/libs/**/*.aar

# Tooling noise
.commandcode/
.vscode/
.idea/

# OS/editor noise
.DS_Store
Thumbs.db
*.log
